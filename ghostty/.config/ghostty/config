window-decoration = false
# confirm-close-surface = false

background-opacity = 0.85
background-blur-radius = 0
foreground = bbbbbb

background = 000000
cursor-style = block
cursor-style-blink = true
shell-integration-features = no-cursor

font-family = JetBrains Mono
font-size = 15

# theme 

# normal
palette = 0=#000000
palette = 1=#5f8787
palette = 2=#bf8fb5
palette = 3=#a87da0
palette = 4=#888888
palette = 5=#999999
palette = 6=#aaaaaa
palette = 7=#c1c1c1

# bright
palette = 8=#333333
palette = 9=#5f8787
palette = 10=#bf8fb5
palette = 11=#a87da0
palette = 12=#888888
palette = 13=#999999
palette = 14=#aaaaaa
palette = 15=#c1c1c1

# unbind alt combinations to select tabs in tmux
keybind = unconsumed:alt+one=ignore 
keybind = unconsumed:alt+two=ignore 
keybind = unconsumed:alt+three=ignore 
keybind = unconsumed:alt+four=ignore 
keybind = unconsumed:alt+five=ignore 
keybind = unconsumed:alt+six=ignore 
keybind = unconsumed:alt+seven=ignore 
keybind = unconsumed:alt+eight=ignore 
keybind = unconsumed:alt+nine=ignore 
keybind = unconsumed:alt+zero=ignore 

keybind = ctrl+shift+j=increase_font_size:1
keybind = ctrl+shift+k=decrease_font_size:1
keybind = ctrl+shift+ö=reset_font_size
